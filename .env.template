# Alfred — environment template. Copy to .env and fill in. Never put real
# values in this file: it is tracked by git.

# ── Database and app ──────────────────────────────────────
DATABASE_URL=postgresql://localhost:5432/mia
# Signs the dashboard session cookie. Generate: python -c "import secrets;print(secrets.token_hex(32))"
MIA_SESSION_SECRET=
# The one account `mia lockdown` keeps. Share links stay off unless MIA_SHARING=1.
MIA_OWNER=akshit
MIA_SHARING=false

# ── Models ────────────────────────────────────────────────
# Gemini (aistudio.google.com): search, Marshal, Analysts, embeddings, and the
# fallback at the end of every role. Required.
GEMINI_API_KEY=
MIA_EMBED_PROVIDER=gemini

# Azure AI Foundry: endpoint and key from the portal (resource or project
# endpoint both work). Deployment names must match the portal. Optional —
# with no endpoint every role falls back to Gemini.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_DEPLOY_GPT55=gpt-5.5                 # brief Editor, research synthesis
AZURE_DEPLOY_GPT54_MINI=gpt-5.4-mini       # the Verifier
AZURE_DEPLOY_DEEPSEEK=DeepSeek-V3.2        # reasoning fallback
AZURE_DEPLOY_MAVERICK=Llama-4-Maverick-17B-128E-Instruct-FP8   # classification, extraction

# Spend caps, USD, across every provider, checked before every model call.
#   daily      any rolling 24 hours (a brief is ~$1.25 with GPT-5.5)
#   scheduled  the share of the daily cap briefs and harvests may use;
#              the rest is kept for your own questions
#   monthly    any rolling 30 days
MIA_DAILY_USD_CAP=8.00
MIA_SCHEDULED_DAILY_USD_CAP=5.00
MIA_MONTHLY_USD_CAP=150.00

# ── Data ──────────────────────────────────────────────────
# FRED: https://fredaccount.stlouisfed.org/apikeys (free)
FRED_API_KEY=

# ── Brokers (read-only) ───────────────────────────────────
# Zerodha Kite Connect: developers.kite.trade. Redirect URL to register:
# https://<your-domain>/brokers/kite/callback
KITE_API_KEY=
KITE_API_SECRET=
# Webull OpenAPI: webull.com.au → OpenAPI Management. Region au or us.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_REGION=au

# Coinbase: a CDP API key with the View permission ONLY (portal.cdp.coinbase.com).
# Alfred checks the key's permissions and refuses one that can trade.
COINBASE_API_KEY_NAME=
COINBASE_API_KEY_ID=
COINBASE_API_PRIVATE_KEY=

# Data feeds that are not brokers (conf/data.yaml). All free tiers.
# Finnhub https://finnhub.io · Twelve Data https://twelvedata.com · CoinGecko demo key
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
COINGECKO_API_KEY=

# ── Email (send-only) ─────────────────────────────────────
# Resend (resend.com) with a "Sending access" key. Until a domain is verified,
# mail can only go to the address the Resend account was opened with.
RESEND_API_KEY=
MIA_EMAIL_TO=
# MIA_EMAIL_FROM="Alfred <alfred@your-domain>"   # after verifying a domain

# ── Observability ─────────────────────────────────────────
TRODO_SITE_ID=
