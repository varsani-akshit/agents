# ── REQUIRED ─────────────────────────────────────────────
# Anthropic API key (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# ── STRONGLY RECOMMENDED (both free) ─────────────────────
# FRED API key: https://fredaccount.stlouisfed.org/apikeys (instant, free)
FRED_API_KEY=

# Voyage AI embeddings (finance-tuned): https://dashboard.voyageai.com
# Free tier is plenty. If empty, I fall back to a local embedding model.
VOYAGE_API_KEY=

# ── SLACK (can be added later; system runs in dry-run without) ──
# Create two channels, then https://api.slack.com/messaging/webhooks
# (Create app → Incoming Webhooks → add one webhook per channel)
SLACK_WEBHOOK_CRITICAL=
SLACK_WEBHOOK_DIGESTS=

# ── DO NOT EDIT (defaults for local build) ───────────────
DATABASE_URL=postgresql://localhost:5432/mia
DIGEST_MODEL=claude-sonnet-5
CLASSIFY_MODEL=claude-haiku-4-5
# Hard daily spend cap in USD for Anthropic calls (guards the $5 credit)
MIA_DAILY_USD_CAP=0.60
MIA_TOTAL_USD_CAP=3.00

# Signs the dashboard session cookie. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
# If unset the app generates an ephemeral key and every restart logs you out.
MIA_SESSION_SECRET=
