[Unit]
Description=Alfred scheduler - ingestion, briefs, maintenance
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=__APP_DIR__/.venv/bin/python cli.py serve
Restart=always
RestartSec=15
# Exactly one instance, ever: two would double-ingest and write duplicate briefs.

[Install]
WantedBy=multi-user.target
